{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vitest"],
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "noEmit": true
  },
  "include": ["*.ts"]
}
