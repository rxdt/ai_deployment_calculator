{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend"],
  "ignoreBinaries": ["semgrep"],
  "include": [
    "files",
    "exports",
    "nsExports",
    "types",
    "nsTypes"
  ],
  "entry": [
    "**/main.ts",
    "**/index.ts",
    "**/cli.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.config.js",
    "**/*.config.cjs",
    "**/*.config.mjs",
    "**/*.config.ts",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "project": ["**/*.ts", "**/*.mjs", "**/*.js", "**/*.cjs"]
}
