{
  "name": "ai-deployment-calculator-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "./harness.mjs"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0",
    "npm": ">=10"
  },
  "scripts": {
    "format": "cd .. && harness/node_modules/.bin/prettier . --check --ignore-path harness/.prettierignore",
    "gate": "node harness.mjs gate",
    "harness": "node harness.mjs",
    "html": "cd .. && harness/node_modules/.bin/html-validate --config harness/.htmlvalidate.json \"**/*.html\"",
    "lint": "npm run eslint && npm run style && npm run html",
    "eslint": "cd .. && harness/node_modules/.bin/eslint . --config harness/eslint.config.js --max-warnings=0",
    "preflight": "node harness.mjs preflight",
    "style": "cd .. && harness/node_modules/.bin/stylelint \"**/*.css\" --config harness/stylelint.config.js --max-warnings=0 --allow-empty-input",
    "test": "cd .. && harness/node_modules/.bin/vitest run --config harness/vitest.config.js",
    "test:file": "cd .. && harness/node_modules/.bin/vitest run --config harness/vitest.config.js --coverage=false",
    "test:coverage": "cd .. && harness/node_modules/.bin/vitest run --config harness/vitest.config.js --coverage",
    "test:e2e": "cd .. && harness/node_modules/.bin/playwright test --config harness/playwright.config.js",
    "setup:e2e": "playwright install --with-deps",
    "typecheck": "npm run typecheck:harness && npm run typecheck:project",
    "typecheck:frontend": "npm run typecheck:project",
    "typecheck:harness": "tsc -p tsconfig.json --noEmit",
    "typecheck:project": "cd .. && harness/node_modules/.bin/tsc -p harness/tsconfig.app.json --noEmit",
    "lint:design": "cd .. && harness/node_modules/.bin/designmd lint DESIGN.md"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@eslint/js": "latest",
    "@eslint/json": "latest",
    "@google/design.md": "latest",
    "@lhci/cli": "latest",
    "@playwright/test": "latest",
    "@secretlint/secretlint-rule-preset-recommend": "latest",
    "@size-limit/file": "latest",
    "@stoplight/spectral-cli": "latest",
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "ajv": "latest",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "latest",
    "ajv-keywords": "latest",
    "cspell": "^9.8.0",
    "dependency-cruiser": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-import-resolver-node": "latest",
    "eslint-plugin-import-x": "latest",
    "eslint-plugin-jsdoc": "latest",
    "eslint-plugin-n": "latest",
    "eslint-plugin-no-only-tests": "latest",
    "eslint-plugin-promise": "latest",
    "eslint-plugin-regexp": "latest",
    "eslint-plugin-security": "latest",
    "eslint-plugin-sonarjs": "latest",
    "eslint-plugin-unicorn": "latest",
    "fast-check": "latest",
    "globals": "latest",
    "html-validate": "latest",
    "jiti": "latest",
    "jsdom": "latest",
    "knip": "latest",
    "lighthouse": "latest",
    "lockfile-lint": "latest",
    "markuplint": "latest",
    "npm-package-json-lint": "latest",
    "pnpm": "latest",
    "prettier": "^3.9.4",
    "secretlint": "latest",
    "size-limit": "latest",
    "stylelint": "latest",
    "stylelint-config-standard": "latest",
    "stylelint-declaration-strict-value": "latest",
    "syncpack": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "fast-json-patch": "latest"
  },
  "npmpackagejsonlint": {
    "rules": {
      "dependencies-type": "error",
      "devDependencies-type": "error",
      "engines-type": "error",
      "name-type": "error",
      "no-archive-dependencies": "error",
      "no-archive-devDependencies": "error",
      "no-duplicate-properties": "error",
      "no-file-dependencies": "error",
      "no-file-devDependencies": "error",
      "no-git-dependencies": "error",
      "no-git-devDependencies": "error",
      "no-repeated-dependencies": "error",
      "prefer-alphabetical-dependencies": "error",
      "prefer-alphabetical-devDependencies": "error",
      "prefer-no-engineStrict": "error",
      "private-type": "error",
      "require-engines": "error",
      "require-name": "error",
      "require-private": "error",
      "require-scripts": "error",
      "require-type": "error",
      "type-type": "error",
      "valid-values-private": [
        "error",
        [
          true
        ]
      ],
      "valid-values-type": [
        "error",
        [
          "module"
        ]
      ]
    }
  }
}
