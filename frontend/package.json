{
  "name": "ai-deployment-calculator-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "pnpm --prefix ../harness run lint",
    "setup:e2e": "pnpm --prefix ../harness run setup:e2e",
    "test:file": "pnpm --prefix ../harness run test:file --",
    "test": "pnpm test:coverage",
    "test:coverage": "vitest run --config ../harness/vitest.config.js --coverage --coverage.include=\"frontend/src/**/*.ts\" ../frontend/src/*.test.ts",
    "test:e2e": "pnpm --prefix ../harness run test:e2e",
    "typecheck": "pnpm --prefix ../harness run typecheck:frontend"
  },
  "dependencies": {
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "fast-check": "latest",
    "jsdom": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "size-limit": [
    {
      "name": "main JS",
      "path": "dist/assets/*.js",
      "limit": "17 kB"
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "limit": "6 B"
    }
  ]
}
